<idea-plugin>
    <!-- Reverse-domain id under a namespace the author controls. Note this differs
         from the Kotlin package (com.claudecode.chatplugin), which is fine. -->
    <id>io.github.repozitorro.claudebrains</id>
    <name>Claude Brains</name>
    <vendor url="https://github.com/repozitorro/claude-brains">repozitorro</vendor>

    <description><![CDATA[
        Claude Brains — a chat UI front-end for the Claude Code CLI, right inside
        your JetBrains IDE (WebStorm, IntelliJ IDEA, PyCharm, etc). Wraps the
        <code>claude</code> CLI as a subprocess instead of relying on a bare terminal:
        <ul>
            <li>Streaming chat panel with markdown rendering</li>
            <li>Multiple named, parallel sessions</li>
            <li>Slash-command autocomplete</li>
            <li>Model selector</li>
            <li>Send selected code / whole file to Claude with one action</li>
            <li>Floating prompt popup near the caret</li>
        </ul>
        Requires the Claude Code CLI to be installed separately and available on
        PATH (or configured with a full path in Settings). It runs the CLI as a
        subprocess and reuses its existing login, so no API key is needed.
    ]]></description>


    <depends>com.intellij.modules.platform</depends>

    <!-- The embedded browser moved into its own bundled plugin in 2026.2; without
         this its classes aren't on our classpath at all. Optional because JCEF
         isn't shipped for every OS/architecture. -->
    <depends optional="true" config-file="claude-brains-jcef.xml">com.intellij.modules.jcef</depends>

    <!-- Supplies the shell that a refused command can be handed to. Optional:
         the terminal is a bundled plugin and can be turned off. -->
    <depends optional="true" config-file="claude-brains-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Claude Brains"
                    secondary="true"
                    icon="/icons/claude.svg"
                    anchor="right"
                    factoryClass="com.claudecode.chatplugin.ui.ChatToolWindowFactory"/>

        <!-- ClaudeSessionManager, ClaudeCliService and ClaudeCodeSettings are all
             annotated with @Service and are auto-registered as "light services" -
             no explicit <projectService> declaration needed on modern platforms. -->

        <projectConfigurable
            parentId="tools"
            id="com.claudecode.chatplugin.settings"
            displayName="Claude Brains"
            instance="com.claudecode.chatplugin.ui.ClaudeBrainsConfigurable"/>

        <notificationGroup id="Claude Brains" displayType="BALLOON"/>

        <!-- The review strip over an editor. The platform positions it, layers
             it and shows/hides it; the provider only decides when the file has
             something left to review. -->
        <editorFloatingToolbarProvider
            implementation="com.claudecode.chatplugin.review.ReviewFloatingToolbarProvider"/>
    </extensions>

    <actions>
        <!-- Contents of the floating review strip, in the order they appear.
             The id is referenced by ReviewFloatingToolbarProvider. -->
        <group id="ClaudeCodeChat.ReviewToolbar">
            <action id="ClaudeCodeChat.ReviewCounter"
                    class="com.claudecode.chatplugin.review.ReviewCounterAction"
                    text="Changes Awaiting Review"
                    description="How many changes are left here and in the other files of this turn"/>
            <action id="ClaudeCodeChat.AcceptFile"
                    class="com.claudecode.chatplugin.review.AcceptFileChangesAction"
                    text="Accept File"
                    description="Accept every change in this file"/>
            <action id="ClaudeCodeChat.RejectFile"
                    class="com.claudecode.chatplugin.review.RejectFileChangesAction"
                    text="Reject File"
                    description="Reject every change in this file"/>
            <action id="ClaudeCodeChat.PreviousChange"
                    class="com.claudecode.chatplugin.review.PreviousChangeAction"
                    icon="AllIcons.Actions.PreviousOccurence"
                    text="Previous Change"
                    description="Previous change, across every changed file"/>
            <action id="ClaudeCodeChat.NextChange"
                    class="com.claudecode.chatplugin.review.NextChangeAction"
                    icon="AllIcons.Actions.NextOccurence"
                    text="Next Change"
                    description="Next change, across every changed file"/>
        </group>

        <group id="ClaudeCodeChat.EditorPopup" text="Claude Brains" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>

            <action id="ClaudeCodeChat.SendSelection"
                    class="com.claudecode.chatplugin.actions.SendSelectionToClaudeAction"
                    text="Send Selection to Claude"
                    description="Send the highlighted code to the Claude Code chat panel"/>

            <action id="ClaudeCodeChat.SendFile"
                    class="com.claudecode.chatplugin.actions.SendFileToClaudeAction"
                    text="Reference This File in Chat"
                    description="Mention this file's path in the chat so Claude can read it itself"/>
        </group>

        <action id="ClaudeCodeChat.FloatingPrompt"
                class="com.claudecode.chatplugin.actions.FloatingPromptAction"
                text="Claude Code: Floating Prompt"
                description="Open a lightweight prompt popup near the caret">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift C"/>
        </action>

        <action id="ClaudeCodeChat.UsageStats"
                class="com.claudecode.chatplugin.actions.ShowUsageStatsAction"
                text="Claude Brains: Usage Statistics"
                description="Token usage by project, branch and model"/>

        <action id="ClaudeCodeChat.AcceptAllChanges"
                class="com.claudecode.chatplugin.actions.AcceptAllChangesAction"
                text="Accept All Claude Changes"
                description="Keep every change Claude made in this project"/>

        <action id="ClaudeCodeChat.RejectAllChanges"
                class="com.claudecode.chatplugin.actions.RejectAllChangesAction"
                text="Reject All Claude Changes"
                description="Restore every file Claude changed to how it was before"/>

        <action id="ClaudeCodeChat.RenameSession"
                class="com.claudecode.chatplugin.actions.RenameSessionAction"
                text="Claude Brains: Rename Chat"
                description="Give the open conversation a name you'll recognise"/>

        <action id="ClaudeCodeChat.DeleteSession"
                class="com.claudecode.chatplugin.actions.DeleteSessionAction"
                text="Claude Brains: Delete Chat"
                description="Delete the open conversation"/>

        <action id="ClaudeCodeChat.NewSession"
                class="com.claudecode.chatplugin.actions.NewSessionAction"
                text="Claude Code: New Chat Session"
                description="Start a new named Claude Code chat session"/>
    </actions>
</idea-plugin>
